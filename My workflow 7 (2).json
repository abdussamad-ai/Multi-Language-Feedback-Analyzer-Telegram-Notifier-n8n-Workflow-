    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  try {\n    // জেমিনি থেকে আসা র ডেটা বা টেক্সট নেওয়া\n    let rawText = item.json.text || JSON.stringify(item.json);\n    \n    // টেক্সট পরিষ্কার করে প্রপার জেসন এ রূপান্তর\n    rawText = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n    const parsedData = JSON.parse(rawText);\n    \n    // নতুন ফিল্ড যুক্ত করা যা পরবর্তীতে If নোডে ব্যবহার করা যাবে\n    item.json.sentiment = parsedData.sentiment;\n  } catch (error) {\n    item.json.sentiment = \"Unknown\";\n  }\n}\nreturn $input.all();"
      },
